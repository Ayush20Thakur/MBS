# Server Configuration
PROJECT_NAME="SentinelFlow"
ENVIRONMENT="development"
PORT=8000
DEBUG=True
SECRET_KEY="super-secret-key-change-in-production-environment"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL="sqlite+aiosqlite:///./sentinelflow.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sentinelflow"

# Redis Configuration (Cache, Rate Limiting, Event Streaming)
REDIS_URL="redis://localhost:6379/0"

# Fraud Detection Engine Parameters
VELOCITY_WINDOW_SECONDS=60
VELOCITY_MAX_TRANSACTIONS=5
MAX_SINGLE_TRANSACTION_LIMIT=50000.00
FRAUD_RISK_THRESHOLD=0.75

# Observability
PROMETHEUS_METRICS_ENABLED=True
LOG_LEVEL="INFO"
